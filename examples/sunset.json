{
  "format": "artapp-script",
  "version": 1,
  "title": "Sunset over the sea",
  "notes": "A demo for art-cli. Back to front: sky, glow, sun, clouds, headland, sea, reflection, waves, birds.",
  "seed": 11,
  "palette": {
    "night":      "#2A1E48",
    "dusk":       "#6B3A6E",
    "ember":      "#E0704A",
    "gold":       "#F7B25A",
    "haze":       "#FFDCA0",
    "sun_core":   "#FFF7DE",
    "sun_edge":   "#FFC870",
    "cloud_dark": "#4A2F5C",
    "cloud_pink": "#E39488",
    "cloud_lit":  "#FFC28A",
    "land":       "#2C1F3A",
    "sea_top":    "#B8645A",
    "sea_mid":    "#5A3A5E",
    "sea_deep":   "#1A1D3A",
    "glint":      "#FFE6A8",
    "glint_warm": "#FFB060",
    "wave_dark":  "#141530",
    "bird":       "#1E1428"
  },
  "commands": [
    { "cmd": "canvas", "width": 1600, "height": 1000, "paper": "#000000" },

    { "cmd": "layer", "name": "Sky" },
    { "cmd": "gradient", "from": [0, 0], "to": [0, 620],
      "stops": [[0, "night"], [0.35, "dusk"], [0.7, "ember"], [0.88, "gold"], [1, "haze"]] },

    { "cmd": "layer", "name": "Glow", "blend": "screen" },
    { "cmd": "gradient", "kind": "radial", "from": [800, 600], "to": [800, 80],
      "stops": [[0, "#FFE8B0"], [0.35, "#C8704080"], [1, "transparent"]] },

    { "cmd": "layer", "name": "Sun" },
    { "cmd": "ellipse", "center": [800, 590], "radius": 92,
      "fill": { "gradient": "radial", "from": [800, 590], "to": [800, 498], "stops": [[0, "sun_core"], [0.75, "#FFE6A8"], [1, "sun_edge"]] } },
    { "cmd": "snapshot", "name": "sky and sun" },

    { "cmd": "layer", "name": "Clouds" },
    { "cmd": "brush", "hardness": 0.1, "flow": 0.35, "opacity": 0.55 },
    { "cmd": "path", "points": [[-50, 150], [300, 130], [700, 165], [1050, 140]], "size": 90, "color": "cloud_dark", "taper": [0.2, 0.6], "jitter": 8, "opacity": 0.8 },
    { "cmd": "path", "points": [[-50, 175], [250, 168], [560, 185]], "size": 40, "color": "cloud_pink", "taper": [0.1, 0.6], "opacity": 0.35 },
    { "cmd": "path", "points": [[900, 110], [1250, 95], [1650, 120]], "size": 75, "color": "cloud_dark", "taper": 0.4, "jitter": 8, "opacity": 0.8 },
    { "cmd": "path", "points": [[1000, 132], [1300, 122], [1560, 138]], "size": 30, "color": "cloud_pink", "taper": 0.5, "opacity": 0.35 },
    { "cmd": "path", "points": [[150, 300], [500, 280], [820, 310]], "size": 45, "color": "cloud_pink", "taper": 0.45, "jitter": 5 },
    { "cmd": "path", "points": [[980, 330], [1300, 300], [1620, 320]], "size": 50, "color": "cloud_pink", "taper": [0.5, 0.2], "jitter": 5 },
    { "cmd": "path", "points": [[420, 430], [700, 418], [960, 432]], "size": 22, "color": "cloud_lit", "taper": 0.45, "opacity": 0.6 },
    { "cmd": "path", "points": [[1050, 455], [1300, 445], [1500, 458]], "size": 18, "color": "cloud_lit", "taper": 0.45, "opacity": 0.5 },
    { "cmd": "path", "points": [[60, 480], [300, 470], [520, 485]], "size": 16, "color": "cloud_pink", "taper": 0.45, "opacity": 0.45 },
    { "cmd": "brush", "hardness": 0.8, "flow": 1, "opacity": 1 },

    { "cmd": "layer", "name": "Headland" },
    { "cmd": "polygon", "points": [[-20, 625], [-20, 545], [60, 538], [150, 552], [230, 548], [330, 575], [430, 596], [520, 612], [600, 625]],
      "fill": "land", "jitter": 3 },
    { "cmd": "polygon", "points": [[1250, 625], [1330, 606], [1420, 597], [1520, 600], [1620, 590], [1620, 625]],
      "fill": "#3A2948", "jitter": 2 },

    { "cmd": "layer", "name": "Sea" },
    { "cmd": "rect", "x": 0, "y": 620, "width": 1600, "height": 380,
      "fill": { "gradient": "linear", "from": [0, 620], "to": [0, 1000], "stops": [[0, "sea_top"], [0.3, "sea_mid"], [1, "sea_deep"]] } },
    { "cmd": "snapshot", "name": "blocked in" },

    { "cmd": "layer", "name": "Reflection", "blend": "screen" },
    { "cmd": "line", "from": [800, 622], "to": [800, 1060], "size": 300, "hardness": 0, "flow": 0.6,
      "opacity": 0.45, "color": "#D07848", "taper": [0.9, 0], "note": "a soft glow that widens towards us" },
    { "cmd": "line", "from": [800, 622], "to": [800, 1060], "size": 110, "hardness": 0, "flow": 0.6,
      "opacity": 0.4, "color": "#F0A860", "taper": [0.8, 0] },
    { "cmd": "scatter", "area": { "polygon": [[740, 623], [860, 623], [930, 760], [990, 1000], [610, 1000], [670, 760]] },
      "count": 320, "kind": "stroke", "length": [10, 80], "angle": [-2, 2], "size": [1.5, 5],
      "colors": ["glint", "glint_warm", "sun_edge"], "opacity": [0.4, 1], "hardness": 0.6 },

    { "cmd": "layer", "name": "Waves" },
    { "cmd": "scatter", "note": "far: many small ripples", "area": { "rect": [0, 626, 1600, 70] },
      "count": 900, "kind": "stroke", "length": [6, 28], "angle": [-1, 1], "size": [1, 2],
      "color": "wave_dark", "opacity": [0.15, 0.35], "seed": 21 },
    { "cmd": "scatter", "note": "middle", "area": { "rect": [0, 690, 1600, 140] },
      "count": 700, "kind": "stroke", "length": [20, 70], "angle": [-2, 2], "size": [2, 3],
      "color": "wave_dark", "opacity": [0.15, 0.4], "seed": 22 },
    { "cmd": "scatter", "note": "near: big, few", "area": { "rect": [0, 820, 1600, 190] },
      "count": 420, "kind": "stroke", "length": [50, 160], "angle": [-3, 3], "size": [3, 6],
      "color": "wave_dark", "opacity": [0.15, 0.4], "seed": 23 },
    { "cmd": "scatter", "note": "light on the ripples", "area": { "rect": [0, 630, 1600, 370] },
      "count": 500, "kind": "stroke", "length": [10, 90], "angle": [-2, 2], "size": [1, 3],
      "color": "cloud_pink", "opacity": [0.1, 0.3], "seed": 24 },
    { "cmd": "line", "from": [0, 621], "to": [1600, 621], "size": 3, "color": "haze", "opacity": 0.5, "taper": 0.1 },
    { "cmd": "snapshot", "name": "sea details" },

    { "cmd": "layer", "name": "Birds" },
    { "cmd": "brush", "color": "bird", "hardness": 0.9 },
    { "cmd": "path", "points": [[1060, 300], [1078, 288], [1092, 298]], "size": 4, "taper": [0.5, 0] },
    { "cmd": "path", "points": [[1092, 298], [1108, 286], [1128, 296]], "size": 4, "taper": [0, 0.5] },
    { "cmd": "path", "points": [[1150, 262], [1162, 254], [1172, 261]], "size": 3, "taper": [0.5, 0] },
    { "cmd": "path", "points": [[1172, 261], [1183, 253], [1196, 260]], "size": 3, "taper": [0, 0.5] },
    { "cmd": "path", "points": [[1010, 240], [1020, 234], [1028, 239]], "size": 2.5, "taper": [0.5, 0] },
    { "cmd": "path", "points": [[1028, 239], [1036, 233], [1046, 238]], "size": 2.5, "taper": [0, 0.5] },

    { "cmd": "layer", "name": "Vignette", "blend": "multiply" },
    { "cmd": "gradient", "kind": "radial", "from": [800, 560], "to": [800, -480],
      "stops": [[0.5, "#FFFFFF"], [1, "#6E5878"]] },
    { "cmd": "snapshot", "name": "finished" }
  ]
}
