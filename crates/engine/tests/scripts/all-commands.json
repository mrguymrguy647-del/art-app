{
  "format": "artapp-script",
  "version": 1,
  "title": "Every command",
  "notes": "Used by tests/reference.rs: every command and option from before groups, so old scripts must keep painting exactly these pixels.",
  "seed": 9,
  "palette": { "sky": "#5080D0", "sun": "#FFC040", "ink": "#202020", "leaf": "#3A8A40", "glass": "#80C0FF80" },
  "commands": [
    { "cmd": "canvas", "width": 600, "height": 400, "paper": "#F8F4EC" },
    { "cmd": "paper", "color": "#FAF6EE" },
    { "cmd": "stroke", "points": [[5, 395], [80, 380]], "note": "before any layer command" },
    { "cmd": "layer", "name": "Sky" },
    { "cmd": "gradient", "from": [0, 0], "to": [0, 300], "stops": [[0, "sky"], [0.6, "#C0D8F0"], [1, "transparent"]] },
    { "cmd": "gradient", "kind": "radial", "from": [450, 80], "to": [450, 10], "colors": ["#FFFFFFC0", "transparent"], "opacity": 0.8 },
    { "cmd": "layer", "name": "Shapes" },
    { "cmd": "ellipse", "center": [450, 80], "radius": [50, 40], "rotation": 20, "fill": "sun", "outline": "ink", "outline_size": 3, "jitter": 3, "seed": 4 },
    { "cmd": "rect", "x": 30, "y": 200, "width": 160, "height": 90, "radius": 14, "rotation": -8,
      "fill": { "gradient": "linear", "from": [30, 200], "to": [190, 290], "stops": [[0, "sun"], [1, "sky"]] }, "outline": "#000", "opacity": 0.9 },
    { "cmd": "polygon", "points": [[300, 380], [340, 250], [380, 380], [280, 300], [400, 300]], "fill": "ink", "opacity": 0.6 },
    { "cmd": "rect", "x": 60, "y": 220, "width": 40, "height": 40, "fill": "#000", "erase": true },
    { "cmd": "path", "points": [[420, 200], [480, 170], [560, 210], [520, 280], [440, 270]], "closed": true, "fill": "leaf", "color": "ink", "size": 4, "jitter": 2 },
    { "cmd": "path", "points": [[200, 40], [260, 90, 0.4], [320, 40]], "taper": [0.2, 0.5], "size": 10, "color": "#8040A0" },
    { "cmd": "path", "points": [[220, 120], [280, 100], [330, 140]], "closed": true, "line": false,
      "fill": { "gradient": "radial", "from": [275, 120], "to": [330, 120], "colors": ["#FFFFFF", "glass"] } },
    { "cmd": "brush", "color": "ink", "size": 7, "opacity": 0.9, "flow": 0.7, "hardness": 0.5, "spacing": 0.15,
      "pressure_size": true, "pressure_opacity": false, "pressure_flow": true },
    { "cmd": "stroke", "points": [[20, 20], [90, 60, 0.3], [160, 30, 1]], "jitter": 2, "seed": 2 },
    { "cmd": "stroke", "points": [[20, 80], [160, 90]], "color": "sun", "size": 14, "opacity": 0.5, "hardness": 1, "flow": 0.4 },
    { "cmd": "erase", "points": [[100, 10], [100, 100]], "size": 8 },
    { "cmd": "line", "from": [20, 140], "to": [180, 160], "taper": 0.4, "size": 9 },
    { "cmd": "line", "from": [20, 170], "to": [180, 180], "taper": 0, "jitter": 3 },
    { "cmd": "layer", "name": "Texture", "below": "Shapes", "blend": "multiply", "opacity": 0.7 },
    { "cmd": "hatch", "area": { "ellipse": [450, 330, 120, 50] }, "angle": 20, "spacing": 7, "cross": true, "size": 2, "jitter": 2, "taper": [0.1, 0.3], "color": "#604030" },
    { "cmd": "hatch", "area": { "polygon": [[220, 300], [300, 260], [280, 390]] }, "size": 3 },
    { "cmd": "layer", "name": "Bits", "above": "Shapes", "blend": "screen" },
    { "cmd": "scatter", "area": { "circle": [120, 330, 60] }, "count": 80, "size": [2, 8], "colors": ["sun", "#FFFFFF"], "opacity": [0.4, 1], "hardness": 0.2 },
    { "cmd": "scatter", "area": { "rect": [400, 120, 180, 60] }, "count": 30, "kind": "stroke", "length": [10, 30], "angle": [-30, 30], "size": [1, 3], "color": "#FFFFFF", "seed": 5 },
    { "cmd": "snapshot", "name": "middle" },
    { "cmd": "layer", "name": "Fills" },
    { "cmd": "fill", "at": [450, 230], "color": "#FF000040", "tolerance": 0.2, "grow": 2 },
    { "cmd": "fill", "at": [580, 20], "color": "#00000010", "sample": "layer", "opacity": 0.5 },
    { "cmd": "layer", "name": "Scratch" },
    { "cmd": "rect", "x": 0, "y": 0, "width": 50, "height": 50, "fill": "#F00" },
    { "cmd": "clear_layer" },
    { "cmd": "rect", "x": 0, "y": 0, "width": 50, "height": 50, "fill": "#0F0" },
    { "cmd": "clear_layer", "name": "Scratch" },
    { "cmd": "rename_layer", "name": "Scratch", "to": "Gone" },
    { "cmd": "delete_layer", "name": "Gone" },
    { "cmd": "layer", "name": "Hidden", "visible": false },
    { "cmd": "ellipse", "center": [300, 200], "radius": 100, "fill": "#F0F" },
    { "cmd": "move_layer", "name": "Fills", "index": 1 },
    { "cmd": "move_layer", "name": "Bits", "below": "Texture" },
    { "cmd": "move_layer", "name": "Hidden", "above": "Sky" },
    { "cmd": "layer", "name": "Shapes" },
    { "cmd": "gradient", "from": [0, 300], "to": [0, 400], "colors": ["#00000000", "#000000FF"], "erase": true, "area": { "rect": [0, 300, 600, 100] } }
  ]
}
