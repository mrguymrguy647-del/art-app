{
  "title": "Study: Friedrich, Wanderer above the Sea of Fog (big shapes and palette only)",
  "palette": { "sky": "#C3C7D6", "fog": "#A7ACB7", "fog_far": "#8D95A1", "ridge": "#737E89", "rock_dark": "#2F2F34", "rock": "#4A4C50", "figure": "#161419" },
