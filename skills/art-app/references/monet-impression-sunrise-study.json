{
  "title": "Study: Monet, Impression, Sunrise (big shapes and palette only)",
  "palette": { "fog": "#808071", "fog_cool": "#63726C", "fog_warm": "#8F6E5A", "water": "#626A5C", "dark": "#384739", "sun": "#E8743A" },
  "intent": { "subject": "a harbour in fog at sunrise, one orange sun", "focal": "sun", "light": [340, 230], "mood": "hushed, grey-blue", "key_colors": ["fog_cool", "fog_warm", "sun"] },
  "commands": [
    { "cmd": "canvas", "width": 512, "height": 397, "paper": "fog" },
    { "cmd": "layer", "name": "Sky" },
    { "cmd": "gradient", "from": [0, 0], "to": [0, 397], "colors": ["fog_cool", "fog", "water"] },
    { "cmd": "layer", "name": "Harbour" },
    { "cmd": "group", "name": "cranes", "commands": [
      { "cmd": "brush", "size": 3, "color": "fog_cool", "opacity": 0.5 },
      { "cmd": "line", "from": [60, 200], "to": [70, 120], "size": 3, "color": "fog_cool", "opacity": 0.5 },
      { "cmd": "line", "from": [130, 210], "to": [150, 110], "size": 3, "color": "fog_cool", "opacity": 0.5 },
      { "cmd": "line", "from": [400, 215], "to": [420, 140], "size": 3, "color": "fog_cool", "opacity": 0.5 },
      { "cmd": "brush", "reset": true },
      { "cmd": "rect", "x": 0, "y": 215, "width": 512, "height": 20, "fill": "fog_cool", "opacity": 0.6, "jitter": 4 } ] },
    { "cmd": "group", "name": "sun", "commands": [
      { "cmd": "ellipse", "center": [340, 230], "radius": 14, "fill": "sun" },
      { "cmd": "ellipse", "center": [330, 190], "radius": [70, 30], "fill": "fog_warm", "opacity": 0.5, "jitter": 6 } ] },
    { "cmd": "layer", "name": "Water" },
    { "cmd": "group", "name": "reflection", "commands": [
      { "cmd": "repeat", "count": 7, "step": { "translate": [0, 20] }, "commands": [
        { "cmd": "line", "from": [326, 262], "to": [356, 262], "size": 4, "color": "sun", "opacity": 0.8 } ] } ] },
    { "cmd": "group", "name": "boats", "commands": [
      { "cmd": "polygon", "points": [[200, 300], [250, 296], [246, 312], [204, 314]], "fill": "dark" },
      { "cmd": "line", "from": [224, 300], "to": [226, 268], "size": 2, "color": "dark" },
      { "cmd": "polygon", "points": [[300, 340], [340, 336], [336, 350], [304, 352]], "fill": "dark", "opacity": 0.7 } ] }
  ]
}
