{ "title": "Every library part in one pond", "palette": { "sky": "#8EC1E6", "bank": "#6B8F3A" }, "commands": [
    { "cmd": "canvas", "width": 640, "height": 400, "paper": "sky" },
    { "cmd": "include", "file": "cloud.json" },
    { "cmd": "include", "file": "water.json" },
    { "cmd": "include", "file": "grass.json" },
    { "cmd": "include", "file": "reed.json" },
    { "cmd": "include", "file": "tree.json" },
    { "cmd": "include", "file": "lilypad.json" },
    { "cmd": "include", "file": "duck.json" },
    { "cmd": "layer", "name": "Sky" },
    { "cmd": "use", "name": "cloud", "translate": [130, 70] },
    { "cmd": "use", "name": "cloud", "translate": [460, 50], "with": { "puff": 0.7 } },
    { "cmd": "layer", "name": "Bank" },
    { "cmd": "rect", "x": 0, "y": 230, "width": 640, "height": 170, "fill": "bank" },
    { "cmd": "use", "name": "tree", "translate": [110, 240] },
    { "cmd": "use", "name": "tree", "translate": [560, 236], "scale": 0.7, "with": { "seed": 4 } },
    { "cmd": "layer", "name": "Water" },
    { "cmd": "use", "name": "water", "translate": [320, 330], "scale": [1.6, 1.2] },
    { "cmd": "layer", "name": "On the water" },
    { "cmd": "use", "name": "lilypad", "translate": [480, 330], "with": { "notch": 160 } },
    { "cmd": "use", "name": "lilypad", "translate": [420, 365], "scale": 0.8, "with": { "notch": 30 } },
    { "cmd": "use", "name": "duck", "translate": [220, 320], "filter": { "shadow": { "offset": [0, 10], "blur": 8, "color": "#00000050" } } },
    { "cmd": "layer", "name": "Front" },
    { "cmd": "repeat", "count": 4, "step": { "translate": [22, 3] }, "each": { "lean": [4, -8, 10, -3] }, "commands": [
      { "cmd": "use", "name": "reed", "translate": [40, 300], "with": { "lean": "$lean" } } ] },
    { "cmd": "use", "name": "grass", "translate": [320, 248], "scale": 2.2, "with": { "blade": [10, 20], "spacing": 3 } } ] }
