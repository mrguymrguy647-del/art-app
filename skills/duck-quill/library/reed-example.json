{ "palette": { "sky": "#DCE8F0", "water": "#4A78B8" }, "commands": [
    { "cmd": "canvas", "width": 320, "height": 200, "paper": "sky" },
    { "cmd": "include", "file": "reed.json" },
    { "cmd": "rect", "x": 0, "y": 160, "width": 320, "height": 40, "fill": "water" },
    { "cmd": "repeat", "count": 5, "step": { "translate": [34, 2] }, "each": { "lean": [4, -8, 10, -2, 6] }, "commands": [
      { "cmd": "use", "name": "reed", "translate": [90, 166], "with": { "lean": "$lean" } } ] } ] }
