{
  "title": "Study: Chelsea the cat (big shapes and palette only)",
  "palette": { "tan": "#A67C5B", "pink": "#B59789", "brown": "#876145", "dark": "#6D4429", "darkest": "#3D2514", "green": "#9AA85A", "black": "#1A1410" },
